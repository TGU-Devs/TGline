<p style="margin:0 0 24px;"><%= @message %></p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;margin:0 0 24px;">
  <tr>
    <td align="center">
      <a href="<%= @post_url %>" style="display:inline-block;background:#0ea5e9;color:#ffffff;text-decoration:none;padding:12px 28px;border-radius:8px;font-weight:700;">
